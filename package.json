{
  "name": "bookfit-marketplace-local",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx scripts/dev.mjs",
    "dev:web": "vite --host 127.0.0.1",
    "dev:api": "tsx watch server/index.ts",
    "start:api": "tsx server/index.ts",
    "local:start": "node scripts/start-local-supabase.mjs",
    "local:env": "node scripts/write-local-env.mjs",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json",
    "test": "node --disable-warning=ExperimentalWarning --experimental-strip-types --test tests/*.test.mjs",
    "test:integration": "node --disable-warning=ExperimentalWarning --experimental-strip-types --test tests/integration/*.test.mjs",
    "test:coverage": "node --disable-warning=ExperimentalWarning --experimental-strip-types --experimental-test-coverage --test-coverage-include='src/domain/**/*.ts' --test tests/*.test.mjs"
  },
  "dependencies": {
    "fastify": "5.12.8",
    "pg": "8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/pg": "8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "supabase": "2.122.1",
    "typescript": "~5.9.3",
    "tsx": "4.23.15",
    "vite": "^7.3.7"
  }
}
