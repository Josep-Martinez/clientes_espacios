# Placeholder only: `pnpm local:env` writes the real loopback URL to ignored .env.local.
# Do not replace it with a hosted Supabase URL or expose database credentials to Vite.
NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=3001
BOOKFIT_DEV_PROFILES=true
BOOKFIT_PAYMENT_MODE=fake
SESSION_TTL_HOURS=168
# Local only. Run `pnpm local:env` after `supabase db reset --local` to create
# the server-only connection string in the ignored `.env.local` file.
DATABASE_URL=generated-by-pnpm-local-env
